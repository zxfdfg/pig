<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.product.mapper.StockLogMapper">

	<!-- 通用查询映射结果 -->
	<resultMap id="baseResultMap" type="com.pig4cloud.pig.product.api.entity.ProductStockLog">
		<id column="id" property="id"/>
		<result column="product_id" property="productId"/>
		<result column="sku_id" property="skuId"/>
		<result column="type" property="type"/>
		<result column="quantity" property="quantity"/>
		<result column="before_stock" property="beforeStock"/>
		<result column="after_stock" property="afterStock"/>
		<result column="order_id" property="orderId"/>
		<result column="remark" property="remark"/>
		<result column="create_time" property="createTime"/>
		<result column="create_by" property="createBy"/>
	</resultMap>

	<!-- 查询商品的库存日志 -->
	<select id="listLogsByProductId" resultMap="baseResultMap">
		SELECT * FROM product_stock_log
		WHERE product_id = #{productId}
		<if test="skuId != null">
			AND sku_id = #{skuId}
		</if>
		ORDER BY create_time DESC
	</select>

	<!-- 查询订单的库存日志 -->
	<select id="listLogsByOrderId" resultMap="baseResultMap">
		SELECT * FROM product_stock_log
		WHERE order_id = #{orderId}
		ORDER BY create_time DESC
	</select>

	<!-- 查询指定类型的库存日志 -->
	<select id="listLogsByType" resultMap="baseResultMap">
		SELECT * FROM product_stock_log
		WHERE type = #{type}
		<if test="startTime != null">
			AND create_time &gt;= #{startTime}
		</if>
		<if test="endTime != null">
			AND create_time &lt;= #{endTime}
		</if>
		ORDER BY create_time DESC
	</select>

	<!-- 统计库存变动 -->
	<select id="sumQuantityByProductId" resultType="java.lang.Integer">
		SELECT COALESCE(SUM(quantity), 0) FROM product_stock_log
		WHERE product_id = #{productId}
		<if test="skuId != null">
			AND sku_id = #{skuId}
		</if>
		<if test="type != null">
			AND type = #{type}
		</if>
	</select>

</mapper>
